<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_word_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖  Random Word"
            android:textColor="#DFF8EC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/word_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_word_button"
            android:gravity="center"
            android:text="↻"
            android:textColor="#DFF8EC"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/word_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Resilient"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/word_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="مرن / قادر على التعافي"
        android:textColor="#B8E2D2"
        android:textSize="13sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/word_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="She is resilient in difficult times."
        android:textColor="#9CC7B8"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>